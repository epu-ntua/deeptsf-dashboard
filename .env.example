CHOKIDAR_USEPOLLING=true
REACT_APP_NAME=Load_Forecasting_Dashboard
REACT_APP_AUTH=True
REACT_APP_MLFLOW=<mlflow_tracking_server_uri>
REACT_APP_KEYCLOAK_REALM=<keycloak_realm_name>
REACT_APP_KEYCLOAK_URL=<keycloak_realm_link>
REACT_APP_KEYCLOAK_CLIENT_ID=<keycloak_client_name>
REACT_APP_DAGSTER_ENDPOINT_URL=<deeptsf_dagster_link>
REACT_APP_BACKEND_BASE_URL=<deeptsf_backend_link>
# Same-origin path the ingress proxies to the Chronos-2 inference server
REACT_APP_CHRONOS_BASE_URL=/chronos
# Chronos-2 server the nginx in the image proxies /chronos to
# (read at container start: restart the container after changing, no rebuild needed).
# a) Default remote server:
# CHRONOS_SCHEME=https
# CHRONOS_HOST=chronos2-inference-server.aiodp.ai
# b) Chronos-2 API of a DeepTSF keycloak stack, on this or another machine:
# CHRONOS_SCHEME=https
# CHRONOS_HOST=deeptsf-chronos.<domain>
# c) Chronos-2 container on the same docker network (DeepTSF local compose):
# CHRONOS_SCHEME=http
# CHRONOS_HOST=chronos:8000
# Certificate check for https upstreams; off only for a self-signed test server:
# CHRONOS_SSL_VERIFY=on
# Chronos-2 API token (no REACT_APP_ prefix, so it never reaches the browser).
# The nginx in the image sends it to Chronos-2 as "Authorization: Bearer <token>",
# and the `npm start` dev proxy does the same. It must equal the Chronos-2
# server's API token (for b, DeepTSF's CHRONOS_API_TOKEN). On Kubernetes the
# ingress injects the header instead - see app.chronos.apiToken in the helm chart.
CHRONOS_API_TOKEN=<chronos2_api_token>
# Last resort only: this variant IS baked into the JS bundle and readable by any
# user, so prefer the two options above.
# REACT_APP_CHRONOS_API_TOKEN=<chronos2_api_token>
# Target of the `npm start` dev proxy for /chronos (defaults to the aiodp server)
# CHRONOS_PROXY_TARGET=https://deeptsf-chronos.<domain>

# Show the Foundation Models (Chronos-2) page: True / False
REACT_APP_FOUNDATION_MODELS=True
# Codeless Forecast experiment: True = choose from the MLflow experiments the user can access,
# False = type the experiment name
REACT_APP_EXPERIMENT_LIST=False

# Existing docker network the dashboard container joins
COMPOSE_NETWORK=keycloak_net
