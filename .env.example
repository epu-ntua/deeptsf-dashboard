CHOKIDAR_USEPOLLING=true
REACT_APP_NAME=Load_Forecasting_Dashboard
REACT_APP_AUTH=True
REACT_APP_MLFLOW=<mlflow_tracking_server_uri>
REACT_APP_KEYCLOAK_REALM=<keycloak_realm_name>
REACT_APP_KEYCLOAK_URL=<keycloak_realm_link>
REACT_APP_KEYCLOAK_CLIENT_ID=<keycloak_client_name>
REACT_APP_DAGSTER_ENDPOINT_URL=<deeptsf_dagster_link>
REACT_APP_BACKEND_BASE_URL=<deeptsf_backend_link>
# Same-origin path the ingress proxies to the Chronos-2 inference server
REACT_APP_CHRONOS_BASE_URL=/chronos
# Chronos-2 API token, used by the dev server proxy only (no REACT_APP_ prefix,
# so it never reaches the browser bundle). In production the ingress injects the
# same header instead - see app.chronos.apiToken in the helm chart.
CHRONOS_API_TOKEN=<chronos2_api_token>
# Last resort only: this variant IS baked into the JS bundle and readable by any
# user, so prefer the two options above.
# REACT_APP_CHRONOS_API_TOKEN=<chronos2_api_token>

# Show the Foundation Models (Chronos-2) page: True / False
REACT_APP_FOUNDATION_MODELS=True
# Codeless Forecast experiment: True = choose from the MLflow experiments the user can access,
# False = type the experiment name
REACT_APP_EXPERIMENT_LIST=False